{
  "format": 1,
  "protocol": "shard-2",
  "name": "shard-2-nano",
  "display_name": "Shard 2 Nano",
  "version": "1.0.0",
  "license": "apache-2.0",
  "io": {
    "input": {
      "name": "input",
      "dtype": "float32",
      "shape": [
        "batch",
        32,
        6
