      "column": "attack_this_tick"
    },
    {
      "name": "ticks_since_attack",
      "op": "value",
      "column": "ticks_since_attack"
    },
    {
      "name": "accel_yaw",
      "op": "accel",
      "column": "yaw"
    },
    {
      "name": "accel_pitch",
      "op": "accel",
      "column": "pitch"
    }
